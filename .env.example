# Dadur Ranna Environment Variables

# Provider selection: "gemma" (default) or "openai_compat"
LLM_PROVIDER=gemma

# --- Google AI Studio Gemma Config ---
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMMA_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-3-27b-it

# --- OpenAI-Compatible Endpoint (Ollama, vLLM, LM Studio, etc.) ---
# Optional if LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma:27b
LLM_API_KEY=ollama

# Server port (Render sets this dynamically)
PORT=3000
